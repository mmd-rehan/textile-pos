# ─────────────────────────────────────────────────────────────────────────────
# TextilePOS — the ONE environment file for the whole project.
#
#   cp .env.example .env      # then edit the values below
#
# Read by the backend (NestJS + Prisma), the frontend dev server (Vite) and
# docker-compose.yml. There are no backend/.env or frontend/.env files.
# .env is gitignored — never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# Connection string the backend uses with `npm run dev` and `npm run db:*`.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE   (URL-encode special
# characters in the password, e.g. @ → %40, # → %23).
#
#   Docker MySQL (npm run db:up):  mysql://textile_pos:change_me@localhost:3306/textile_pos
#   MySQL installed on this PC:    mysql://root:your_password@localhost:3306/textile_pos
#   Hosted, e.g. SkySQL:           mysql://user:password@your-host.skysql.com:4000/textile_pos?sslaccept=strict
DATABASE_URL="mysql://textile_pos:change_me@localhost:3306/textile_pos"

# Only used by docker-compose.yml (`npm run db:up` / `docker compose up`).
# If you use your own MySQL server you can leave these as they are.
MYSQL_DATABASE=textile_pos
MYSQL_USER=textile_pos
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_PORT=3306

# Full Docker stack only: database for the backend container when it should not
# use the bundled `mysql` service (e.g. a hosted server). Leave unset otherwise.
# DOCKER_DATABASE_URL="mysql://user:password@your-host:4000/textile_pos?sslaccept=strict"

# ── Ports ────────────────────────────────────────────────────────────────────
BACKEND_PORT=5001
FRONTEND_PORT=5173

# ── Backend ──────────────────────────────────────────────────────────────────
NODE_ENV=development
# Long random string, e.g. `openssl rand -hex 32`.
JWT_SECRET=change_me_jwt_secret
JWT_EXPIRES_IN=8h
# Where uploaded purchase invoices are stored (relative to backend/).
STORAGE_PATH=./storage

# ── Seed (npm run db:seed) ───────────────────────────────────────────────────
# The admin user is created once, on the first seed.
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@textilepos.local
SEED_ADMIN_PASSWORD=change_me_admin_password
# Set to true to overwrite the existing admin's password on the next seed.
SEED_RESET_ADMIN_PASSWORD=false
SEED_COMPANY_NAME=Textile & POS ERP
SEED_BASE_CURRENCY=USD
# true adds demo products, suppliers, sales… (or run `npm run db:seed:dev`).
SEED_DEV_DATA=false

# ── Frontend ─────────────────────────────────────────────────────────────────
# Only for production / Docker builds: the API URL the BROWSER calls. With
# `npm run dev` the Vite dev server proxies /api to BACKEND_PORT instead.
VITE_API_BASE_URL=http://localhost:5001/api/v1

# ── Tests (optional) ─────────────────────────────────────────────────────────
# Integration tests WIPE this database; its name must end in _test.
# Export it in your shell before `npm test --workspace=backend`.
# TEST_DATABASE_URL="mysql://root:change_me_root@127.0.0.1:3306/textile_pos_test"

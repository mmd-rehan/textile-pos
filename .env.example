# ─────────────────────────────────────────────────────────────────────────────
# Root .env for the full-stack Docker deployment (docker-compose.yml).
#
#   cp .env.example .env   # then EDIT every "change_me_*" value below.
#
# .env is gitignored — never commit real secrets. .env.example must stay free of
# real secrets. (This is independent of docker/.env, which is only used by the
# local `npm run setup` MySQL-only flow.)
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
MYSQL_DATABASE=textile_pos
MYSQL_USER=textile_pos
MYSQL_PASSWORD=change_me_strong
MYSQL_ROOT_PASSWORD=change_me_root_strong

# ── Host port mappings ───────────────────────────────────────────────────────
# MySQL host port (container is always 3306 internally). 3307 avoids clashing
# with a MySQL started by `npm run setup` on 3306.
MYSQL_PORT=3307
BACKEND_PORT=5001
FRONTEND_PORT=5173

# ── Backend secrets ──────────────────────────────────────────────────────────
JWT_SECRET=change_me_jwt_secret
JWT_EXPIRES_IN=8h
SESSION_SECRET=change_me_session_secret

# Allowed browser origin for the API (frontend URL).
CORS_ORIGIN=http://localhost:5173

# ── Seed / company defaults (standard system seed) ───────────────────────────
SEED_COMPANY_NAME=Textile & POS ERP
SEED_BASE_CURRENCY=USD
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@textilepos.local
SEED_ADMIN_PASSWORD=change_me_admin_password

# Set to true ONLY if you want demo/sample data (products, suppliers, sales, …).
# Leave false for a clean deployment.
SEED_DEV_DATA=false

# ── Frontend build arg ───────────────────────────────────────────────────────
# Absolute API URL the BROWSER will call. Must match how users reach the backend.
#   Local Docker on host:  http://localhost:5001/api/v1
#   Production domain:     https://api.example.com/api/v1
# Never use the Docker service name `backend` here — the browser can't resolve it.
VITE_API_BASE_URL=http://localhost:5001/api/v1

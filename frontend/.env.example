# Generated by scripts/setup.sh.

# Relative path used by the API client; the Vite dev server proxies /api → backend.
VITE_API_URL=/api/v1

# Absolute backend URL (handy for tools/scripts that hit the API directly).
VITE_API_BASE_URL=http://localhost:5001/api/v1

# Backend port — vite.config.ts uses this to target the dev proxy.
VITE_BACKEND_PORT=5001

# ── Docker / production note ─────────────────────────────────────────────────
# This file drives the local `npm run dev` flow (relative VITE_API_URL + Vite
# proxy). In the Docker build there is NO Vite proxy: the frontend is built with
# VITE_API_BASE_URL (root .env) baked in as an ABSOLUTE URL the browser can reach,
# e.g. http://localhost:5001/api/v1 locally or https://api.example.com/api/v1 in
# production. See docker-compose.yml (frontend build arg) and the README.

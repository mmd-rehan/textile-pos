# Generated by scripts/setup.sh.

# Relative path used by the API client; the Vite dev server proxies /api → backend.
VITE_API_URL=/api/v1

# Absolute backend URL (handy for tools/scripts that hit the API directly).
VITE_API_BASE_URL=http://localhost:5001/api/v1

# Backend port — vite.config.ts uses this to target the dev proxy.
VITE_BACKEND_PORT=5001

# Generated by scripts/setup.sh.
NODE_ENV=development
PORT=5001

# MySQL connection string. host/port must match docker/.env MYSQL_PORT.
DATABASE_URL="mysql://textile_pos:change-me@localhost:3306/textile_pos"

# Auth secrets (rotate before production).
JWT_SECRET="change-me-jwt-secret"
JWT_EXPIRES_IN=8h
SESSION_SECRET="change-me-session-secret"

# Allowed origin for the frontend dev server.
CORS_ORIGIN=http://localhost:5173

# Storage path for purchase attachments.
STORAGE_PATH=./storage

# Base currency code (3-letter ISO). Sales are denominated in this currency.
BASE_CURRENCY_CODE=USD

# Seeder inputs. Read by prisma/seed.ts.
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@textilepos.local
SEED_ADMIN_PASSWORD=
SEED_COMPANY_NAME=Textile & POS ERP
SEED_BASE_CURRENCY=USD
SEED_RESET_ADMIN_PASSWORD=false

# Set true ONLY to also seed demo/sample business data. Standard system seed is
# always run; demo data is opt-in (the Docker deployment leaves this false).
SEED_DEV_DATA=false

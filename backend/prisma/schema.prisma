generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ProductType {
  FABRIC_ROLL
  CUT_PIECE
  FIXED_PRODUCT
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum RollStatus {
  IN_STOCK
  ALLOCATED
  SOLD
  WASTED
  DAMAGED
  FINISHED
}

enum ReconciliationResult {
  MATCHED
  SHRINKAGE
  EXCESS
  REMNANT
}

enum WastageSourceType {
  SALE_OVERCUT
  MANUAL_DAMAGE
  MANUAL_WASTAGE
  RECONCILIATION_LOSS
}

enum RemnantStatus {
  AVAILABLE
  SOLD
  DISCARDED
}

enum SaleType {
  WHOLESALE
  RETAIL
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIALLY_PAID
  UNPAID
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  REFUNDED
  FAILED
}

enum MovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  WASTAGE
  RECONCILIATION
  RETURN
  REMNANT_CREATED
}

enum MovementDirection {
  IN
  OUT
}

enum CustomerType {
  RETAIL
  WHOLESALE
  CREDIT
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

// ==========================================
// CURRENCY MODEL
// ==========================================

model Currency {
  code           String  @id
  name           String
  symbol         String
  decimalPlaces  Int     @default(2) @map("decimal_places")
  isBaseCurrency Boolean @default(false) @map("is_base_currency")
  isActive       Boolean @default(true) @map("is_active")

  fromRates CurrencyExchangeRate[] @relation("FromCurrency")
  toRates   CurrencyExchangeRate[] @relation("ToCurrency")

  @@map("currencies")
}

model CurrencyExchangeRate {
  id                String   @id @default(uuid())
  fromCurrencyCode  String   @map("from_currency_code")
  toCurrencyCode    String   @map("to_currency_code")
  rate              Decimal  @db.Decimal(18, 6)
  isCurrent         Boolean  @default(true) @map("is_current")
  effectiveFrom     DateTime @default(now()) @map("effective_from")
  notes             String?  @db.Text
  createdByUserId   String?  @map("created_by_user_id")
  updatedByUserId   String?  @map("updated_by_user_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  fromCurrency Currency @relation("FromCurrency", fields: [fromCurrencyCode], references: [code], onDelete: Restrict)
  toCurrency   Currency @relation("ToCurrency", fields: [toCurrencyCode], references: [code], onDelete: Restrict)

  @@unique([fromCurrencyCode, toCurrencyCode, isCurrent], name: "unique_current_rate")
  @@index([fromCurrencyCode, toCurrencyCode])
  @@map("currency_exchange_rates")
}

// ==========================================
// ACCESS MODELS
// ==========================================

model User {
  id           String     @id @default(uuid())
  username     String     @unique
  email        String     @unique
  passwordHash String     @map("password_hash")
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  userRoles                  UserRole[]
  sessions                   Session[]
  activityLogs               ActivityLog[]
  auditLogs                  AuditLog[]
  inventoryMovements         InventoryMovement[]
  stockAdjustments           StockAdjustment[]
  wastageEntries             WastageEntry[]
  responsibleWastageEntries  WastageEntry[]       @relation("ResponsibleUserWastage")
  rollReconciliations        RollReconciliation[]
  saleInvoices               SaleInvoice[]        @relation("CashierInvoices")
  salePayments               SalePayment[]        @relation("ReceivedByPayments")
  customerPayments           CustomerPayment[]    @relation("ReceivedByCustomerPayments")

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String
  details   String?  @db.Text
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("activity_logs")
}

// ==========================================
// SETTINGS MODELS
// ==========================================

model CompanySetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String   @db.Text
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("company_settings")
}

model AppSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String   @db.Text
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

model FeatureFlag {
  id          String   @id @default(uuid())
  name        String   @unique
  isEnabled   Boolean  @default(false) @map("is_enabled")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

// ==========================================
// AUDIT MODELS
// ==========================================

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String
  tableName String   @map("table_name")
  recordId  String   @map("record_id")
  oldValues String?  @db.Text @map("old_values")
  newValues String?  @db.Text @map("new_values")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

// ==========================================
// CATALOG MODELS
// ==========================================

model Category {
  id          String   @id @default(uuid())
  name        String
  description String?
  parentId    String?  @map("parent_id")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  parent        Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  subcategories Category[] @relation("CategoryHierarchy")
  products      Product[]

  @@map("categories")
}

model Brand {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("brands")
}

// Global color catalog shared across products and rolls
model Color {
  id        String   @id @default(uuid())
  name      String   @unique
  colorCode String?  @map("color_code")
  hexCode   String?  @map("hex_code")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products         Product[]
  productColors    ProductColor[]
  rolls            Roll[]
  saleItems        SaleInvoiceItem[]
  productStockItems ProductStockItem[]

  @@map("colors")
}

// Global design/pattern catalog shared across products and rolls
model Design {
  id          String   @id @default(uuid())
  name        String   @unique
  designCode  String?  @map("design_code")
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products          Product[]
  productDesigns    ProductDesign[]
  rolls             Roll[]
  saleItems         SaleInvoiceItem[]
  productStockItems ProductStockItem[]

  @@map("designs")
}

model Product {
  id             String        @id @default(uuid())
  productCode    String        @unique @map("product_code")
  name           String
  barcode        String?       @unique
  description    String?
  productType    ProductType   @map("product_type")
  categoryId     String        @map("category_id")
  brandId        String?       @map("brand_id")
  colorId        String?       @map("color_id")
  designId       String?       @map("design_id")
  defaultUnitId  String        @map("default_unit_id")
  retailPrice    Decimal       @db.Decimal(12, 2) @map("retail_price")
  wholesalePrice Decimal       @db.Decimal(12, 2) @map("wholesale_price")
  status         ProductStatus @default(ACTIVE)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  category           Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand              Brand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)
  color              Color?              @relation(fields: [colorId], references: [id], onDelete: SetNull)
  design             Design?             @relation(fields: [designId], references: [id], onDelete: SetNull)
  defaultUnit        Unit                @relation(fields: [defaultUnitId], references: [id], onDelete: Restrict)
  productColors      ProductColor[]
  productDesigns     ProductDesign[]
  rolls              Roll[]
  purchaseItems      PurchaseItem[]
  saleInvoiceItems   SaleInvoiceItem[]
  inventoryMovements InventoryMovement[]
  stockAdjustments   StockAdjustment[]
  wastageEntries     WastageEntry[]
  productStockItems  ProductStockItem[]
  remnants           Remnant[]

  @@index([barcode])
  @@index([productCode])
  @@map("products")
}

// Junction: which Colors a product is available in
model ProductColor {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  colorId   String   @map("color_id")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  color   Color   @relation(fields: [colorId], references: [id], onDelete: Cascade)

  @@unique([productId, colorId])
  @@map("product_colors")
}

// Junction: which Designs a product is available in
model ProductDesign {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  designId  String   @map("design_id")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  design  Design  @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@unique([productId, designId])
  @@map("product_designs")
}

model Unit {
  id           String   @id @default(uuid())
  name         String   @unique
  abbreviation String   @unique
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  products          Product[]
  sourceConversions UnitConversion[]    @relation("SourceUnitConversions")
  targetConversions UnitConversion[]    @relation("TargetUnitConversions")
  inventoryMovements InventoryMovement[]
  wastageEntries     WastageEntry[]
  saleInvoiceItems   SaleInvoiceItem[]
  purchaseItems      PurchaseItem[]
  productStockItems  ProductStockItem[]

  @@map("units")
}

model UnitConversion {
  id         String   @id @default(uuid())
  fromUnitId String   @map("from_unit_id")
  toUnitId   String   @map("to_unit_id")
  factor     Decimal  @db.Decimal(12, 6)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  fromUnit Unit @relation("SourceUnitConversions", fields: [fromUnitId], references: [id], onDelete: Cascade)
  toUnit   Unit @relation("TargetUnitConversions", fields: [toUnitId], references: [id], onDelete: Cascade)

  @@unique([fromUnitId, toUnitId])
  @@map("unit_conversions")
}

// ==========================================
// INVENTORY MODELS
// ==========================================

model Batch {
  id          String    @id @default(uuid())
  batchNumber String    @unique @map("batch_number")
  supplierId  String?   @map("supplier_id")
  notes       String?   @db.Text
  receivedAt  DateTime? @map("received_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  rolls    Roll[]
  remnants Remnant[]

  @@map("batches")
}

model Roll {
  id                   String     @id @default(uuid())
  rollNumber           String     @unique @map("roll_number")
  barcode              String?    @unique
  productId            String     @map("product_id")
  colorId              String?    @map("color_id")
  designId             String?    @map("design_id")
  batchId              String?    @map("batch_id")
  originalLengthYard                    Decimal  @db.Decimal(12, 4) @map("original_length_yard")
  remainingLengthYard                   Decimal  @db.Decimal(12, 4) @map("remaining_length_yard")
  purchasePricePerYardOriginalCurrency  Decimal? @db.Decimal(14, 2) @map("purchase_price_per_yard_original_ccy")
  purchasePricePerYardBaseCurrency      Decimal? @db.Decimal(14, 2) @map("purchase_price_per_yard_base_ccy")
  salePricePerYard                      Decimal? @db.Decimal(12, 2) @map("sale_price_per_yard")
  status               RollStatus @default(IN_STOCK)
  location             String?
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")

  product             Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  color               Color?               @relation(fields: [colorId], references: [id], onDelete: SetNull)
  design              Design?              @relation(fields: [designId], references: [id], onDelete: SetNull)
  batch               Batch?               @relation(fields: [batchId], references: [id], onDelete: SetNull)
  purchaseRolls       PurchaseRoll[]
  saleInvoiceItems    SaleInvoiceItem[]
  inventoryMovements  InventoryMovement[]
  stockAdjustments    StockAdjustment[]
  wastageEntries      WastageEntry[]
  rollReconciliations RollReconciliation[]
  remnantsAsOriginal  Remnant[]            @relation("OriginalRollRemnants")
  remnantsAsNew       Remnant[]            @relation("NewRollRemnant")

  @@index([barcode])
  @@index([rollNumber])
  @@map("rolls")
}

// Quantity-based stock for FIXED_PRODUCT and CUT_PIECE
model ProductStockItem {
  id                               String   @id @default(uuid())
  productId                        String   @map("product_id")
  colorId                          String?  @map("color_id")
  designId                         String?  @map("design_id")
  barcodeValue                     String?  @unique @map("barcode_value")
  quantityOnHand                   Decimal  @db.Decimal(12, 4) @map("quantity_on_hand")
  unitId                           String   @map("unit_id")
  purchasePricePerUnitBaseCurrency Decimal? @db.Decimal(14, 2) @map("purchase_price_per_unit_base_ccy")
  salePricePerUnit                 Decimal? @db.Decimal(12, 2) @map("sale_price_per_unit")
  location                         String?
  description                      String?  @db.Text
  isActive                         Boolean  @default(true) @map("is_active")
  createdAt                        DateTime @default(now()) @map("created_at")
  updatedAt                        DateTime @updatedAt @map("updated_at")

  product            Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  color              Color?            @relation(fields: [colorId], references: [id], onDelete: SetNull)
  design             Design?           @relation(fields: [designId], references: [id], onDelete: SetNull)
  unit               Unit              @relation(fields: [unitId], references: [id], onDelete: Restrict)
  purchaseItems      PurchaseItem[]
  saleInvoiceItems   SaleInvoiceItem[]
  inventoryMovements InventoryMovement[]

  @@index([productId])
  @@index([barcodeValue])
  @@map("product_stock_items")
}

model InventoryMovement {
  id                 String            @id @default(uuid())
  productId          String            @map("product_id")
  rollId             String?           @map("roll_id")
  productStockItemId String?           @map("product_stock_item_id")
  movementType       MovementType      @map("movement_type")
  direction          MovementDirection
  quantity           Decimal           @db.Decimal(12, 4)
  unitId             String            @map("unit_id")
  beforeQuantity     Decimal?          @db.Decimal(12, 4) @map("before_quantity")
  afterQuantity      Decimal?          @db.Decimal(12, 4) @map("after_quantity")
  referenceType      String            @map("reference_type")
  referenceId        String?           @map("reference_id")
  remarks            String?           @db.Text
  userId             String            @map("user_id")
  createdAt          DateTime          @default(now()) @map("created_at")

  product          Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  roll             Roll?             @relation(fields: [rollId], references: [id], onDelete: SetNull)
  productStockItem ProductStockItem? @relation(fields: [productStockItemId], references: [id], onDelete: SetNull)
  unit             Unit              @relation(fields: [unitId], references: [id], onDelete: Restrict)
  user             User              @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([rollId])
  @@index([productStockItemId])
  @@map("inventory_movements")
}

model StockAdjustment {
  id               String   @id @default(uuid())
  productId        String   @map("product_id")
  rollId           String?  @map("roll_id")
  adjustedQuantity Decimal  @db.Decimal(12, 4) @map("adjusted_quantity")
  adjustmentType   String   @map("adjustment_type")
  reason           String   @db.Text
  userId           String   @map("user_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  roll    Roll?   @relation(fields: [rollId], references: [id], onDelete: SetNull)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("stock_adjustments")
}

model WastageEntry {
  id                 String            @id @default(uuid())
  rollId             String?           @map("roll_id")
  productId          String            @map("product_id")
  quantity           Decimal           @db.Decimal(12, 4)
  unitId             String            @map("unit_id")
  sourceType         WastageSourceType @default(SALE_OVERCUT) @map("source_type")
  saleInvoiceId      String?           @map("sale_invoice_id")
  reconciliationId   String?           @map("reconciliation_id")
  responsibleUserId  String?           @map("responsible_user_id")
  reason             String            @db.Text
  userId             String            @map("user_id")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  roll              Roll?              @relation(fields: [rollId], references: [id], onDelete: SetNull)
  product           Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  unit              Unit               @relation(fields: [unitId], references: [id], onDelete: Restrict)
  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  responsibleUser   User?              @relation("ResponsibleUserWastage", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  saleInvoice       SaleInvoice?       @relation(fields: [saleInvoiceId], references: [id], onDelete: SetNull)
  rollReconciliation RollReconciliation? @relation(fields: [reconciliationId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([sourceType])
  @@index([rollId])
  @@map("wastage_entries")
}

model RollReconciliation {
  id                   String                @id @default(uuid())
  rollId               String                @map("roll_id")
  expectedLength       Decimal               @db.Decimal(12, 4) @map("expected_length")
  actualLength         Decimal               @db.Decimal(12, 4) @map("actual_length")
  discrepancy          Decimal               @db.Decimal(12, 4)
  reconciliationResult ReconciliationResult  @map("reconciliation_result")
  reason               String                @db.Text
  remarks              String?               @db.Text
  userId               String                @map("user_id")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  roll          Roll          @relation(fields: [rollId], references: [id], onDelete: Restrict)
  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  remnant       Remnant?
  wastageEntries WastageEntry[]

  @@map("roll_reconciliations")
}

model Remnant {
  id                 String        @id @default(uuid())
  rollId             String        @map("roll_id")
  remnantRollId      String?       @unique @map("remnant_roll_id")
  reconciliationId   String?       @unique @map("reconciliation_id")
  productId          String        @map("product_id")
  batchId            String?       @map("batch_id")
  lengthYard         Decimal       @db.Decimal(12, 4) @map("length_yard")
  barcode            String?       @unique
  salePrice          Decimal?      @db.Decimal(12, 2) @map("sale_price")
  status             RemnantStatus @default(AVAILABLE)
  createdFrom        String        @default("MANUAL") @map("created_from")
  reason             String        @db.Text
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  originalRoll   Roll               @relation("OriginalRollRemnants", fields: [rollId], references: [id], onDelete: Restrict)
  remnantRoll    Roll?              @relation("NewRollRemnant", fields: [remnantRollId], references: [id], onDelete: SetNull)
  reconciliation RollReconciliation? @relation(fields: [reconciliationId], references: [id], onDelete: SetNull)
  product        Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  batch          Batch?             @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([rollId])
  @@index([productId])
  @@map("remnants")
}

// ==========================================
// SALES MODELS
// ==========================================

model Customer {
  id             String         @id @default(uuid())
  name           String
  email          String?        @unique
  phone          String?        @unique
  address        String?        @db.Text
  type           CustomerType   @default(RETAIL)
  status         CustomerStatus @default(ACTIVE)
  creditLimit    Decimal?       @db.Decimal(12, 2) @map("credit_limit")
  currentBalance Decimal        @db.Decimal(12, 2) @default(0.00) @map("current_balance")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  saleInvoices          SaleInvoice[]
  customerLedgerEntries CustomerLedgerEntry[]
  customerPayments      CustomerPayment[]

  @@map("customers")
}

model SaleInvoice {
  id             String        @id @default(uuid())
  invoiceNumber  String        @unique @map("invoice_number")
  customerId     String?       @map("customer_id")
  totalAmount    Decimal       @db.Decimal(12, 2) @map("total_amount")
  discountAmount Decimal       @db.Decimal(12, 2) @default(0.00) @map("discount_amount")
  taxAmount      Decimal       @db.Decimal(12, 2) @default(0.00) @map("tax_amount")
  netAmount      Decimal       @db.Decimal(12, 2) @map("net_amount")
  paidAmount     Decimal       @db.Decimal(12, 2) @default(0.00) @map("paid_amount")
  dueAmount      Decimal       @db.Decimal(12, 2) @map("due_amount")
  currencyCode   String        @default("PKR") @map("currency_code")
  status         InvoiceStatus @default(DRAFT)
  paymentStatus  PaymentStatus @default(PENDING) @map("payment_status")
  saleType       SaleType      @default(RETAIL) @map("sale_type")
  cashierId      String        @map("cashier_id")
  notes            String?       @db.Text
  idempotencyKey   String?       @unique @map("idempotency_key")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  customer         Customer?         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  cashier          User              @relation("CashierInvoices", fields: [cashierId], references: [id], onDelete: Restrict)
  saleInvoiceItems SaleInvoiceItem[]
  salePayments     SalePayment[]
  wastageEntries   WastageEntry[]

  @@index([invoiceNumber])
  @@index([createdAt])
  @@index([saleType])
  @@index([createdAt, saleType])
  @@map("sale_invoices")
}

model SaleInvoiceItem {
  id                 String   @id @default(uuid())
  invoiceId          String   @map("invoice_id")
  productId          String   @map("product_id")
  rollId             String?  @map("roll_id")
  productStockItemId String?  @map("product_stock_item_id")
  colorId            String?  @map("color_id")
  designId           String?  @map("design_id")
  billedQuantity     Decimal  @db.Decimal(12, 4) @map("billed_quantity")
  actualCutQuantity  Decimal? @db.Decimal(12, 4) @map("actual_cut_quantity")
  unitId             String   @map("unit_id")
  unitPrice          Decimal  @db.Decimal(12, 2) @map("unit_price")
  discountAmount     Decimal  @db.Decimal(12, 2) @default(0.00) @map("discount_amount")
  taxAmount          Decimal  @db.Decimal(12, 2) @default(0.00) @map("tax_amount")
  subTotal           Decimal  @db.Decimal(12, 2) @map("sub_total")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  saleInvoice      SaleInvoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product          Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  roll             Roll?             @relation(fields: [rollId], references: [id], onDelete: SetNull)
  productStockItem ProductStockItem? @relation(fields: [productStockItemId], references: [id], onDelete: SetNull)
  color            Color?            @relation(fields: [colorId], references: [id], onDelete: SetNull)
  design           Design?           @relation(fields: [designId], references: [id], onDelete: SetNull)
  unit             Unit              @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@index([rollId])
  @@index([invoiceId])
  @@index([productStockItemId])
  @@map("sale_invoice_items")
}

model SalePayment {
  id                String        @id @default(uuid())
  invoiceId         String        @map("invoice_id")
  paymentMethod     String        @map("payment_method")
  amount            Decimal       @db.Decimal(12, 2)
  transactionNumber String?       @map("transaction_number")
  paymentDate       DateTime      @default(now()) @map("payment_date")
  status            PaymentStatus @default(PAID)
  receivedById      String        @map("received_by_id")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  saleInvoice SaleInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  receivedBy  User        @relation("ReceivedByPayments", fields: [receivedById], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@map("sale_payments")
}

model CustomerPayment {
  id             String   @id @default(uuid())
  customerId     String   @map("customer_id")
  amount         Decimal  @db.Decimal(12, 2)
  paymentMethod  String   @map("payment_method")
  idempotencyKey String?  @unique @map("idempotency_key")
  notes          String?  @db.Text
  receivedById   String   @map("received_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  receivedBy User     @relation("ReceivedByCustomerPayments", fields: [receivedById], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@map("customer_payments")
}

// ==========================================
// PURCHASES MODELS
// ==========================================

model Supplier {
  id             String   @id @default(uuid())
  name           String
  contactName    String?  @map("contact_name")
  email          String?  @unique
  phone          String?  @unique
  address        String?  @db.Text
  currentBalance Decimal  @db.Decimal(12, 2) @default(0.00) @map("current_balance")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  batches               Batch[]
  purchaseOrders        PurchaseOrder[]
  supplierLedgerEntries SupplierLedgerEntry[]
  supplierPayments      SupplierPayment[]

  @@map("suppliers")
}

model PurchaseOrder {
  id                         String        @id @default(uuid())
  poNumber                   String        @unique @map("po_number")
  supplierId                 String        @map("supplier_id")
  purchaseCurrencyCode       String        @default("PKR") @map("purchase_currency_code")
  baseCurrencyCodeAtTime     String        @default("PKR") @map("base_currency_code_at_time")
  exchangeRateToBaseCurrency Decimal       @db.Decimal(18, 6) @default(1.000000) @map("exchange_rate_to_base_currency")
  subtotalOriginalCurrency   Decimal       @db.Decimal(14, 2) @map("subtotal_original_ccy")
  discountOriginalCurrency   Decimal       @db.Decimal(14, 2) @default(0.00) @map("discount_original_ccy")
  taxOriginalCurrency        Decimal       @db.Decimal(14, 2) @default(0.00) @map("tax_original_ccy")
  totalOriginalCurrency      Decimal       @db.Decimal(14, 2) @map("total_original_ccy")
  subtotalBaseCurrency       Decimal       @db.Decimal(14, 2) @map("subtotal_base_ccy")
  discountBaseCurrency       Decimal       @db.Decimal(14, 2) @default(0.00) @map("discount_base_ccy")
  taxBaseCurrency            Decimal       @db.Decimal(14, 2) @default(0.00) @map("tax_base_ccy")
  totalBaseCurrency          Decimal       @db.Decimal(14, 2) @map("total_base_ccy")
  paidAmountOriginalCurrency Decimal       @db.Decimal(14, 2) @default(0.00) @map("paid_amount_original_ccy")
  dueAmountOriginalCurrency  Decimal       @db.Decimal(14, 2) @default(0.00) @map("due_amount_original_ccy")
  status                     InvoiceStatus @default(DRAFT)
  orderDate                  DateTime      @default(now()) @map("order_date")
  deliveryDate               DateTime?     @map("delivery_date")
  notes                      String?       @db.Text
  createdAt                  DateTime      @default(now()) @map("created_at")
  updatedAt                  DateTime      @updatedAt @map("updated_at")

  supplier         Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseItems    PurchaseItem[]
  purchaseRolls    PurchaseRoll[]
  supplierPayments SupplierPayment[]

  @@index([poNumber])
  @@index([createdAt])
  @@index([status])
  @@map("purchase_orders")
}

model SupplierPayment {
  id                         String   @id @default(uuid())
  purchaseOrderId            String   @map("purchase_order_id")
  supplierId                 String   @map("supplier_id")
  amountOriginalCurrency     Decimal  @db.Decimal(14, 2) @map("amount_original_ccy")
  amountBaseCurrency         Decimal  @db.Decimal(14, 2) @map("amount_base_ccy")
  currencyCode               String   @map("currency_code")
  baseCurrencyCodeAtTime     String   @default("PKR") @map("base_currency_code_at_time")
  exchangeRateToBaseCurrency Decimal  @db.Decimal(18, 6) @default(1.000000) @map("exchange_rate_to_base_currency")
  paymentMethod              String   @map("payment_method")
  paymentDate                DateTime @map("payment_date")
  notes                      String?  @db.Text
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  supplier      Supplier      @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
  @@index([supplierId])
  @@map("supplier_payments")
}

model PurchaseItem {
  id                        String   @id @default(uuid())
  purchaseOrderId           String   @map("purchase_order_id")
  productId                 String   @map("product_id")
  productStockItemId        String?  @map("product_stock_item_id")
  orderedQuantity           Decimal  @db.Decimal(12, 4) @map("ordered_quantity")
  receivedQuantity          Decimal  @db.Decimal(12, 4) @default(0.00) @map("received_quantity")
  unitId                    String   @map("unit_id")
  unitCostOriginalCurrency  Decimal  @db.Decimal(14, 2) @map("unit_cost_original_ccy")
  lineTotalOriginalCurrency Decimal  @db.Decimal(14, 2) @map("line_total_original_ccy")
  unitCostBaseCurrency      Decimal  @db.Decimal(14, 2) @map("unit_cost_base_ccy")
  lineTotalBaseCurrency     Decimal  @db.Decimal(14, 2) @map("line_total_base_ccy")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  purchaseOrder    PurchaseOrder     @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product          Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  unit             Unit              @relation(fields: [unitId], references: [id], onDelete: Restrict)
  productStockItem ProductStockItem? @relation(fields: [productStockItemId], references: [id], onDelete: SetNull)

  @@map("purchase_items")
}

model PurchaseRoll {
  id                                   String   @id @default(uuid())
  purchaseOrderId                      String   @map("purchase_order_id")
  rollId                               String   @map("roll_id")
  purchasePricePerUnitOriginalCurrency Decimal  @db.Decimal(14, 2) @map("purchase_price_per_unit_original_ccy")
  purchasePricePerUnitBaseCurrency     Decimal  @db.Decimal(14, 2) @map("purchase_price_per_unit_base_ccy")
  createdAt                            DateTime @default(now()) @map("created_at")
  updatedAt                            DateTime @updatedAt @map("updated_at")

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  roll          Roll          @relation(fields: [rollId], references: [id], onDelete: Restrict)

  @@map("purchase_rolls")
}

// ==========================================
// LEDGER MODELS
// ==========================================

model CustomerLedgerEntry {
  id            String   @id @default(uuid())
  customerId    String   @map("customer_id")
  debit         Decimal  @db.Decimal(12, 2) @default(0.00)
  credit        Decimal  @db.Decimal(12, 2) @default(0.00)
  balanceAfter  Decimal  @db.Decimal(12, 2) @map("balance_after")
  referenceType String   @map("reference_type")
  referenceId   String   @map("reference_id")
  remarks       String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@index([customerId, referenceType, referenceId], name: "cust_ledger_ref_idx")
  @@map("customer_ledger_entries")
}

model SupplierLedgerEntry {
  id                         String   @id @default(uuid())
  supplierId                 String   @map("supplier_id")
  currencyCode               String   @map("currency_code")
  baseCurrencyCodeAtTime     String   @default("PKR") @map("base_currency_code_at_time")
  debitOriginalCurrency      Decimal  @db.Decimal(14, 2) @default(0.00) @map("debit_original_ccy")
  creditOriginalCurrency     Decimal  @db.Decimal(14, 2) @default(0.00) @map("credit_original_ccy")
  exchangeRateToBaseCurrency Decimal  @db.Decimal(18, 6) @map("exchange_rate_to_base_currency")
  debitBaseCurrency          Decimal  @db.Decimal(14, 2) @default(0.00) @map("debit_base_ccy")
  creditBaseCurrency         Decimal  @db.Decimal(14, 2) @default(0.00) @map("credit_base_ccy")
  balanceAfterBase           Decimal  @db.Decimal(14, 2) @map("balance_after_base")
  referenceType              String   @map("reference_type")
  referenceId                String   @map("reference_id")
  remarks                    String?  @db.Text
  createdAt                  DateTime @default(now()) @map("created_at")

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@index([supplierId])
  @@index([supplierId, referenceType, referenceId], name: "supp_ledger_ref_idx")
  @@map("supplier_ledger_entries")
}
